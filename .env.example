# Aplinkos kintamųjų pavyzdys savarankiškam (Proxmox / Docker) diegimui.
# Kopijuokite į .env arba nustatykite Docker / PM2 aplinkoje. Nelaikykite čia slaptų raktų.

# Serverio HTTP prievadas (numatytasis 3000; Cloudflare Tunnel turi kreiptis HTTP į šį prievadą)
PORT=3000

# Vykdymo aplinka: production (aptarnauja dist/ ir /api/*) arba development
NODE_ENV=production

# Nuolatinio duomenų katalogo kelias (turi likti išsaugotas per atnaujinimus: school_database.json, photos/, backups/)
DATA_DIR=./data
